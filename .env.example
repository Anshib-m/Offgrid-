# Copy to server/.env and replace every value. These are placeholders, not real secrets.
# (server/.env.example holds the same template next to the code that reads it.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/offgrid"
JWT_SECRET="replace-with-a-long-random-string"
PSEUDO_PEPPER="replace-with-a-long-random-string"
FIELD_KEY="replace-with-a-long-random-string"
PORT=4000
